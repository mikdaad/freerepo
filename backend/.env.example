# --- DeepSeek (Phase 2 semantic mapping + Phase 4 report drafting) ---------
# Get a key at https://platform.deepseek.com — consumed via the openai SDK.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Offline development: use deterministic stubs instead of calling DeepSeek.
# Also falls back to mock mode automatically when DEEPSEEK_API_KEY is empty.
MOCK_AI=false

# --- Municipality rule (Phase 3) --------------------------------------------
MIN_SETBACK_METERS=1.5

# --- Phase 1: C# CAD engine ---------------------------------------------------
# Preferred: point at the published binary (fast cold start):
#   cd cad-engine/CadEngine && dotnet publish -c Release -r linux-x64 --self-contained false
# CAD_ENGINE_BIN=/path/to/freerepo/cad-engine/CadEngine/bin/Release/net8.0/linux-x64/publish/cad-engine
#
# If unset, the backend falls back to `dotnet run --project cad-engine/CadEngine`.
CAD_ENGINE_TIMEOUT_S=300

# --- Supabase / PostgreSQL (optional) -----------------------------------------
# Project Settings -> Database -> Connection string (port 5432, session mode).
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres

# --- HTTP ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_MAX_MB=200
