    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.18",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.18",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
