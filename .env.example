# ============================================================================
# cad2ai configuration.  Copy to `.env` and fill in.  `.env` is git-ignored.
# Every value below is optional except DEEPSEEK_API_KEY (Phase 3) and the
# APS_* group (only when the Autodesk fallback is used).
# ============================================================================

# ---- Phase 3: DeepSeek ------------------------------------------------------
# Get the key from https://platform.deepseek.com/api_keys and paste it here as
# DEEPSEEK_API_KEY=<your key>.  Never commit a real key: this file is the template,
# .env (git-ignored) is where it belongs.

# Do not add a trailing slash; the SDK appends /chat/completions.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model ids change over time; the current DeepSeek endpoints are
# `deepseek-flash` and `deepseek-v4-pro` (older docs list `deepseek-chat`
# and `deepseek-reasoner`).  Anything valid for your account works.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=8000
# ignored by the API while thinking mode is enabled
DEEPSEEK_TEMPERATURE=0.0
# enabled | disabled  (thinking mode = chain of thought, slower + pricier)
DEEPSEEK_THINKING=disabled
# low | high | max  (only sent when thinking is enabled)
# DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT=180
DEEPSEEK_MAX_ATTEMPTS=5
DEEPSEEK_MIN_INTERVAL_MS=0
# Extra headers as JSON, if your gateway needs them (optional)
# DEEPSEEK_EXTRA_HEADERS={"X-Team": "bim-automation"}

# ---- Phase 1: DWG parsing ---------------------------------------------------
# Absolute path to the ODA File Converter executable (AppImage on Linux,
# .exe on Windows, .app binary on macOS).  Leave empty to use `ODAFileConverter`
# from PATH.
# ODA_EXECUTABLE=/opt/ODAFileConverter/ODAFileConverter.AppImage
# DXF version the converter targets when normalising the DWG (lossless for
# everything ezdxf can represent; ACAD2018 = AC1032 is the safe baseline).
ODA_TARGET_VERSION=ACAD2018
# Refuse absurd inputs before shelling out to the converter.
CAD2AI_MAX_FILE_MB=512

# ---- Phase 2: payload budgeting --------------------------------------------
# Token budget for the JSON payload handed to the model.  Oversized payloads
# are degraded step by step (see docs) instead of being hard-truncated.
CAD2AI_MAX_PAYLOAD_TOKENS=120000
CAD2AI_MAX_TEXT_ITEMS=800
CAD2AI_MAX_DIMENSIONS=400
CAD2AI_MAX_BLOCKS=120
CAD2AI_MAX_LAYERS=200
CAD2AI_FLOAT_PRECISION=3
# Keep AC10xx legacy drawings that ezdxf can only partially represent.
CAD2AI_ALLOW_LEGACY_VERSIONS=0

# ---- Phase 1 fallback: Autodesk Platform Services --------------------------
# Create a Server-to-Server app at https://forge.autodesk.com -> My Apps.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_BASE_URL=https://developer.api.autodesk.com
# Buckets are global namespace: use a unique, lower-case key.
APS_BUCKET_KEY=
APS_POLICY_KEY=transient
APS_SCOPES=data:read data:write data:create bucket:create bucket:read
# svf2 keeps 2D sheet structure; svf is the legacy fallback.
APS_OUTPUT_FORMAT=svf2
APS_TRANSLATION_TIMEOUT=900
APS_MAX_UPLOAD_PART_MB=8

# ---- Misc -------------------------------------------------------------------
CAD2AI_LOG_LEVEL=INFO
