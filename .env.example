# ---------------------------------------------------------------------------------------------
# Copy to `.env` (git-ignored) and fill in. Only `EXPO_PUBLIC_*` values reach the JS bundle —
# they are inlined at build time, so never put a service_role key in here.
# ---------------------------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key. Row Level Security must restrict this to SELECT on the gtfs_* tables.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: sync tuning (defaults shown)
EXPO_PUBLIC_SYNC_PAGE_SIZE=500
EXPO_PUBLIC_SYNC_MAX_RETRIES=3
EXPO_PUBLIC_SYNC_TIMEOUT_MS=20000

# Set to 1 to run entirely against a deterministic in-process feed (no backend, no network).
# Ideal for UI work, demos, and the Node verification harness.
EXPO_PUBLIC_USE_MOCK_GTFS=0

# Optional: verbose sync logging in development
EXPO_PUBLIC_SYNC_DEBUG=0
