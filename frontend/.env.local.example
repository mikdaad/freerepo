# Base URL the browser uses to reach the API.
# Default "/backend" goes through the Next.js rewrite (see next.config.mjs),
# so no CORS configuration is needed during development.
NEXT_PUBLIC_API_BASE=/backend

# Where the dev-server proxy forwards /backend/* requests.
BACKEND_URL=http://localhost:8000

# Alternatively, point the browser directly at the backend (the backend must
# then allow your frontend origin via CORS_ORIGINS):
# NEXT_PUBLIC_API_BASE=http://localhost:8000
